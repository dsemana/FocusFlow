APP_ENV=development
# Optional: otherwise a random key is persisted in instance/secret.key.
# SECRET_KEY=replace-with-a-random-value-at-least-32-characters
# Optional: defaults to instance/focusflow.db (no database server needed).
DATABASE_URL=sqlite:///focusflow.db
# Production requires HTTPS and shared Redis for rate limiting.
RATELIMIT_STORAGE_URI=memory://
# RATELIMIT_STORAGE_URI=redis://127.0.0.1:6379/0
SESSION_IDLE_MINUTES=30
# Set to 1 only behind the single trusted Nginx proxy in deploy/.
TRUST_PROXY=0
PORT=5000
